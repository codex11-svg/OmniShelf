# Local PostgreSQL URL; remote databases can use their provider's connection string.
DATABASE_URL=postgresql://localhost:5432/app_db

# HMAC secret for signing session cookies (use a random 32+ char value outside local demo use)
# Generate with: openssl rand -hex 32
SESSION_SECRET=local-development-secret-change-before-deploy

# Optional: required in production to enable one-tap demo personas. Share privately with testers.
DEMO_ACCESS_KEY=

# Supabase private Storage bucket for new KYC and prescription documents.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Legacy R2 settings are only needed to read documents uploaded before the Supabase migration.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Protects the daily Vercel in-app notification job; use a separate random secret.
CRON_SECRET=

# New uploads use Supabase. Set to local only for explicit local development fallback.
STORAGE_PROVIDER=supabase

# Firebase Authentication (Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
