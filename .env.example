# Local PostgreSQL URL; remote databases can use their provider's connection string.
DATABASE_URL=postgresql://localhost:5432/app_db

# HMAC secret for signing session cookies (use a random 32+ char value outside local demo use)
# Generate with: openssl rand -hex 32
SESSION_SECRET=local-development-secret-change-before-deploy

# Optional: required in production to enable one-tap demo personas. Share privately with testers.
DEMO_ACCESS_KEY=

# Private Cloudflare R2 storage for KYC documents (optional locally, required for uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Protects the daily Vercel in-app notification job; use a separate random secret.
CRON_SECRET=
